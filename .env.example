# Claude API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Only needed for connectors with auth_mode: client_credentials (an app registration)
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=...

# Optional: path to the YAML config (default ./config.yaml)
# KB_HELPER_CONFIG=config.yaml
